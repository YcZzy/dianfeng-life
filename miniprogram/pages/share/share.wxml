<view class="page share-page">
  <view wx:if="{{loading}}" class="skeleton" style="height:640rpx;"></view>
  <view wx:elif="{{error}}" class="center-state"><ui-icon name="shield" color="muted" size="64" /><view class="section-title">{{publicView ? '这份分享暂时无法查看' : '分享卡暂未打开'}}</view><view class="error space" role="alert">{{error}}</view><button class="btn btn-primary" bindtap="{{publicView ? 'onStart' : 'fetch'}}">{{publicView ? '测测我的生活配置' : '重新加载'}}</button></view>
  <block wx:elif="{{summary}}">
    <view class="between"><view class="section-title">{{publicView ? '朋友的生活配置' : '你的分享卡'}}</view><text class="tag">{{publicView ? '公开摘要' : '公开内容预览'}}</text></view>
    <view class="share-card space"><view class="between"><text class="eyebrow">巅峰人生 / LIFE INDEX</text><ui-icon name="compass" color="accent" size="40" /></view><view class="share-rank">{{summary.rankHeadline}}</view><view class="share-rule"></view><view class="eyebrow">生活类型</view><view class="share-title">{{summary.personaTitle}}</view><view class="share-line">{{summary.personaLine}}</view><view class="share-note">{{summary.rankNote}}</view><view class="eyebrow space">娱乐性自述测试，不代表现实成就。</view></view>
    <view wx:if="{{actionError}}" class="error space" role="alert">{{actionError}}</view>
    <block wx:if="{{publicView}}"><button class="btn btn-primary space-lg" bindtap="onStart">那我是什么配置？<ui-icon name="arrow" color="white" size="36" /></button><view class="footer-note">26 道选择题，打开就能测。</view></block>
    <block wx:else>
      <view class="privacy-summary space"><ui-icon name="shield" color="muted" size="30" /><text class="caption">只公开上方内容，不包含具体收入、存款、健康答案。分享链接 7 天后过期。</text></view>
      <button wx:if="{{!token}}" class="btn btn-primary space" loading="{{creating}}" disabled="{{creating}}" bindtap="onCreate">{{revoked ? '重新生成公开分享卡' : '生成这张公开分享卡'}}</button>
      <button wx:if="{{token}}" class="btn btn-primary space" open-type="share"><ui-icon name="share" color="white" size="36" />发送给朋友</button>
      <button class="btn btn-secondary space" loading="{{generating}}" disabled="{{generating}}" bindtap="onImage"><ui-icon name="image" size="34" />{{generating ? '正在生成图片' : '查看海报，长按保存'}}</button>
      <button wx:if="{{token}}" class="text-btn space" bindtap="onRevoke">撤销这份报告的公开分享</button>
    </block>
    <canvas type="2d" id="poster" class="poster-canvas" aria-hidden="true"></canvas>
  </block>
</view>
