page {
  --paper: #F5F4EF;
  --surface: #FFFFFF;
  --ink: #242B29;
  --muted: #64706A;
  --line: #DDDCD3;
  --accent: #A63E2C;
  --tint: #F8ECE7;
  --dark: #283D34;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view, button, text { box-sizing: border-box; }
button { margin: 0; font-family: inherit; font-size: inherit; font-weight: 500; line-height: 1.5; border-radius: 0; background: transparent; color: inherit; }
button::after { border: none; }
button.btn, button.sample-card, button.answer, button.record-open { width: 100%; max-width: none; }
button.text-btn { width: auto; }
button[disabled] { color: var(--muted); background: #EAE9E2; }
.page { max-width: 800rpx; margin: 0 auto; padding: 32rpx 36rpx calc(40rpx + env(safe-area-inset-bottom)); }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.grow { flex: 1; min-width: 0; }
.eyebrow { font-size: 22rpx; line-height: 1.5; color: var(--muted); }
.caption { font-size: 24rpx; line-height: 1.6; color: var(--muted); }
.body { font-size: 28rpx; line-height: 1.75; }
.title { font-family: "Songti SC", "STSong", serif; font-size: 52rpx; font-weight: 600; line-height: 1.3; }
.section-title { font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.num { font-variant-numeric: tabular-nums; font-family: "Avenir Next", "Helvetica Neue", sans-serif; }
.accent { color: var(--accent); }
.card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 24rpx; padding: 28rpx; }
.btn { display: flex; align-items: center; justify-content: center; gap: 14rpx; min-height: 96rpx; padding: 22rpx 28rpx; border-radius: 18rpx; font-size: 30rpx; }
.btn-primary { background: var(--ink); color: #FFFFFF; }
.btn-secondary { border: 1rpx solid var(--line); background: var(--surface); }
.btn-accent { background: var(--accent); color: #FFFFFF; }
.text-btn { min-height: 72rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 14rpx 8rpx; font-size: 26rpx; color: var(--muted); }
.tag { display: inline-flex; align-items: center; gap: 8rpx; border-radius: 8rpx; padding: 6rpx 12rpx; font-size: 22rpx; color: var(--muted); background: #ECECE5; }
.tag-accent { color: var(--accent); background: var(--tint); }
.rule { height: 1rpx; background: var(--line); margin: 28rpx 0; }
.space { margin-top: 24rpx; }
.space-lg { margin-top: 40rpx; }
.error { background: var(--tint); color: #863024; padding: 24rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; }
.center-state { padding: 100rpx 12rpx; text-align: center; }
.center-state .section-title { margin: 24rpx 0 12rpx; }
.center-state .btn { margin-top: 32rpx; }
.skeleton { background: #E7E7DE; border-radius: 16rpx; height: 200rpx; margin-bottom: 24rpx; }
.footer-note { margin-top: 32rpx; font-size: 22rpx; line-height: 1.7; color: var(--muted); text-align: center; }
.icon-wrap { width: 76rpx; height: 76rpx; border-radius: 18rpx; background: #F0F0E9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
@media (max-width: 350px) { .page { padding-left: 24rpx; padding-right: 24rpx; } .title { font-size: 46rpx; } }
